{
  "cleanUrls": true,
  "redirects": [
    { "source": "/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/admin/:path*", "destination": "/", "permanent": true },
    { "source": "/login", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
